# OEM / 平台域名：客户把 CNAME 指到 edge.tokenhub.local 后，由 Caddy 按需签发 HTTPS。
# ask 接口只对已登记品牌域名返回 200，避免给任意主机签发证书。
# 默认走 Let's Encrypt；本地可用 TOKENHUB_ACME_CA 指到 compose 里的 Pebble（自签 CA，仅演练）。
# 公网生产域名 + 真实 LE 仍要 DNS 指向边缘节点，本仓库不把「已对公网签发」标完成。
{
	email {$TOKENHUB_ACME_EMAIL:ops@tokenhub.local}
	on_demand_tls {
		ask http://api:8080/v1/public/tls-check
	}
}

:80 {
	redir https://{host}{uri} permanent
}

:443 {
	tls {
		on_demand
	}
	@api host api.localhost api.oem.localhost
	handle @api {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:3000
	}
}
