# Branding validates ownership and activation before the on-demand TLS gate permits a host.
# Cloudflare Custom Hostnames handles public OEM TLS when configured; Caddy handles the origin.
# Browsers use /api/v1/* and the shared brand model API uses /v1/* on the same hostname.
# Local CA protocol drills live outside the application repository in integration-lab.
{
	email {$TOKENHUB_ACME_EMAIL:ops@tokenhub.local}
	auto_https disable_redirects
	on_demand_tls {
		ask http://api:8080/v1/public/tls-check
	}
}

(app) {
	@private_metrics path /metrics /api/metrics
	handle @private_metrics {
		respond 404
	}

	handle_path /api/* {
		reverse_proxy api:8080 {
			header_up Host {host}
		}
	}

	handle /v1/* {
		reverse_proxy api:8080 {
			header_up Host {host}
		}
	}
	handle /healthz {
		reverse_proxy api:8080
	}
	handle /readyz {
		reverse_proxy api:8080
	}
	handle /.well-known/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000 {
			header_up Host {host}
		}
	}
}

# 容器内仍听 80/443；compose 默认映射到宿主机 9080/9443，避开特权端口。
# .localhost 本地演练走 HTTP，避免 on-demand 去撞公网 Let's Encrypt。
# 真实公网主机仍 HTTP → HTTPS。
:80 {
	@public not host localhost 127.0.0.1 ::1 *.localhost
	redir @public https://{host}{uri} permanent
	import app
}

:443 {
	tls {
		on_demand
	}
	import app
}
