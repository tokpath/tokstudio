# Copy to .env. Do not commit real secrets.

TOKENHUB_ENV=development
TOKENHUB_HTTP_ADDR=:8080
# 本机 make api / e2e 默认直连 8080。docker compose up 后改成 http://localhost:9080（Caddy）。
TOKENHUB_PUBLIC_BASE_URL=http://localhost:8080
# 浏览器跨端口访问 API 时的 CORS Origin。compose 同源入口用 http://localhost:9080。
TOKENHUB_WEB_ORIGIN=http://localhost:3000
# Caddy 映射到宿主机的端口。80/443 常被占用或需要 root，默认 9080/9443。
TOKENHUB_EDGE_HTTP_PORT=9080
TOKENHUB_EDGE_HTTPS_PORT=9443
# Next.js 服务端 / `npm run dev` 的 /api rewrite 目标。compose 里是 http://api:8080。
TOKENHUB_API_INTERNAL_URL=http://127.0.0.1:8080

TOKENHUB_DATABASE_URL=postgres://tokenhub:tokenhub@localhost:5432/tokenhub?sslmode=disable
TOKENHUB_REDIS_URL=redis://localhost:6379/0

# Bootstrap tokens are development-only. Use long random values in any shared environment.
TOKENHUB_BOOTSTRAP_ADMIN_TOKEN=dev_admin_change_me
TOKENHUB_BOOTSTRAP_USER_TOKEN=dev_user_change_me
TOKENHUB_BOOTSTRAP_CHANNEL_TOKEN=dev_admin_change_me-b
# Google OAuth：三件套（CLIENT_ID + CLIENT_SECRET + REDIRECT_URL）齐全才走真实 token/profile 交换。
# 缺任一则登录按钮不可用，默认禁止 mock。仅本地显式 TOKENHUB_GOOGLE_ALLOW_MOCK=true 才允许 mock。
# production / test 预览即使打开 ALLOW_MOCK 也拒绝。
# Google Cloud Console 登记的 Redirect URI：
#   https://test.tokpath.com/login/oauth/google
TOKENHUB_GOOGLE_CLIENT_ID=
TOKENHUB_GOOGLE_CLIENT_SECRET=
TOKENHUB_GOOGLE_REDIRECT_URL=https://test.tokpath.com/login/oauth/google
TOKENHUB_GOOGLE_ALLOW_MOCK=false

# 默认在进程内嵌入 Bifrost SDK，并用 sandbox plugin 回声。
# development/test 未显式设置时默认 true；production 未显式设置时默认 false。
# 设为 false 且至少一把 TOKENHUB_*_API_KEY 或目录账号池有 Key 时才打真实上游。
# 缺 Key 或仍是 sandbox：只回声，不假装 live 上游。test 预览保持 sandbox，不要强制写入 Key。
TOKENHUB_BIFROST_SANDBOX=true
TOKENHUB_OPENAI_API_KEY=
TOKENHUB_ANTHROPIC_API_KEY=
TOKENHUB_GEMINI_API_KEY=
TOKENHUB_OPENROUTER_API_KEY=

# Optional OTLP. Empty means stdout exporter in development.
TOKENHUB_OTEL_EXPORTER_OTLP_ENDPOINT=
TOKENHUB_OTEL_SERVICE_NAME=tokenhub-api

TOKENHUB_LOG_LEVEL=info
TOKENHUB_ENCRYPTION_KEY=dev-only-32-byte-key-change-me!!
TOKENHUB_MEDIA_STORE_PATH=
TOKENHUB_MEDIA_SIGN_KEY=
# 无云 AWS Key 时走本机/Compose MinIO，禁止回退本地盘假装 S3 成功。
TOKENHUB_S3_ENDPOINT=http://127.0.0.1:9000
TOKENHUB_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
TOKENHUB_S3_BUCKET=tokenhub
TOKENHUB_S3_REGION=us-east-1
TOKENHUB_S3_ACCESS_KEY=minioadmin
TOKENHUB_S3_SECRET_KEY=minioadmin
TOKENHUB_S3_FORCE_PATH_STYLE=true
# 媒体：两项都填才走真实 Ark Seedance；否则仍 TestAdapter。不要只填 Key。
TOKENHUB_ARK_BASE_URL=
TOKENHUB_ARK_API_KEY=
# OpenRouter 媒体备份：Base URL + TOKENHUB_OPENROUTER_API_KEY 都齐才走 /videos。
TOKENHUB_OPENROUTER_BASE_URL=
# 公网 OEM HTTPS：Token + Zone 齐才登记 Cloudflare Custom Hostname。.localhost 仍沙箱。
# TOKENHUB_CLOUDFLARE_API_TOKEN=
# TOKENHUB_CLOUDFLARE_ZONE_ID=
# TOKENHUB_CLOUDFLARE_CNAME_TARGET=edge.example.com
# TOKENHUB_CLOUDFLARE_BASE_URL=
TOKENHUB_PAYMENT_SIGN_KEY=
