# 追加到 token 机器上 /root/workspace/nova/Caddyfile。
# www.tokpath.com 保持原样；这个站点只处理 test.tokpath.com，反代到 TokenHub。
test.tokpath.com {
	encode zstd gzip
	reverse_proxy tokstudio-edge:80 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		# 浏览器侧是 HTTPS；edge 只听 80。显式标记 proto，避免会话 cookie 丢 Secure。
		header_up X-Forwarded-Proto https
	}
}
