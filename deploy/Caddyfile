# OEM / 平台域名：客户把 CNAME 指到 TOKENHUB_EDGE_CNAME（公网为 Cloudflare 入口）。
# ask 接口只对已登记品牌域名返回 200，避免给任意主机签发证书。
# 公网 OEM 证书由 Cloudflare Custom Hostname 签发续期；Caddy on-demand 仅作直连源站/本地演练。
# 本地可用 TOKENHUB_ACME_CA 指到 compose 里的 Pebble（自签 CA，仅演练）。
# 不自建公网 Let's Encrypt，也不把 Pebble 标成公网签发。
#
# 浏览器与控制台走同一主机：页面 → web:3000；接口 → /api/*（去掉前缀后到 api:8080）。
# /admin、/channel 是 Next.js 页面，不能整段转给 Go，所以浏览器 API 必须带 /api 前缀。
# SDK / API Key 走 api.localhost、api.oem.localhost，路径保持 OpenAI 兼容的 /v1。
{
	email {$TOKENHUB_ACME_EMAIL:ops@tokenhub.local}
	auto_https disable_redirects
	on_demand_tls {
		ask http://api:8080/v1/public/tls-check
	}
}

(app) {
	@apihost host api.localhost api.oem.localhost
	handle @apihost {
		reverse_proxy api:8080
	}

	handle_path /api/* {
		reverse_proxy api:8080 {
			header_up Host {host}
			header_up X-Forwarded-Proto {header.X-Forwarded-Proto}
		}
	}

	handle /v1/* {
		reverse_proxy api:8080 {
			header_up Host {host}
			header_up X-Forwarded-Proto {header.X-Forwarded-Proto}
		}
	}
	handle /healthz {
		reverse_proxy api:8080
	}
	handle /readyz {
		reverse_proxy api:8080
	}
	handle /.well-known/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000 {
			header_up Host {host}
		}
	}
}

# 容器内仍听 80/443；compose 默认映射到宿主机 9080/9443，避开特权端口。
# .localhost 本地演练走 HTTP，避免 on-demand 去撞公网 Let's Encrypt。
# 真实公网主机仍 HTTP → HTTPS。
:80 {
	@public not host localhost 127.0.0.1 ::1 *.localhost
	redir @public https://{host}{uri} permanent
	import app
}

:443 {
	tls {
		on_demand
	}
	import app
}
