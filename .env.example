# Copy only for a new installation. Never replace an existing .env or its symlink.
# Generate distinct random secrets and set the initial staff identity before migrate.
TOKENHUB_ENV=development
TOKENHUB_HTTP_ADDR=:8080
TOKENHUB_WORKER_HTTP_ADDR=:8081
TOKENHUB_OFFICIAL_HOST=localhost
TOKENHUB_PUBLIC_BASE_URL=http://localhost:9080
TOKENHUB_WEB_ORIGIN=http://localhost:9080
TOKENHUB_API_INTERNAL_URL=http://127.0.0.1:8080
TOKENHUB_EDGE_HTTP_PORT=9080
TOKENHUB_EDGE_HTTPS_PORT=9443
TOKENHUB_TRUSTED_PROXIES=

# Application data-encryption key; API, worker and migrate must use the same value.
# At least 32 characters. Rotating this without migrating ciphertext loses access.
TOKENHUB_APP_KEY=
TOKENHUB_ENCRYPTION_KEY=
TOKENHUB_BOOTSTRAP_STAFF_EMAIL=
TOKENHUB_BOOTSTRAP_STAFF_PASSWORD=
TOKENHUB_BOOTSTRAP_STAFF_NAME=平台负责人
TOKENHUB_BRAND_NAME=TokenHub
TOKENHUB_OPERATOR_NAME=TokenHub 平台
TOKENHUB_LEGAL_NAME=

# Use a fresh database. The migrator rejects the old schema generation.
# Compose uses its private postgres host; this URL is for native Go processes.
TOKENHUB_POSTGRES_PASSWORD=tokenhub
TOKENHUB_DATABASE_URL=postgres://tokenhub:tokenhub@127.0.0.1:5432/tokenhub_v2?sslmode=disable
TOKENHUB_REDIS_URL=redis://127.0.0.1:6379/0
TOKENHUB_WORKER_CONCURRENCY=4

# Official-brand Google sign-in. All three values are required. The redirect must
# be exactly https://官方域名/login/oauth/google. OEM brands are configured in the
# domain workspace and do not use these variables. Leave them empty to disable.
TOKENHUB_GOOGLE_CLIENT_ID=
TOKENHUB_GOOGLE_CLIENT_SECRET=
TOKENHUB_GOOGLE_REDIRECT_URL=https://test.tokpath.com/login/oauth/google

# Real SMTP is required for registration/reset mail. Empty settings do not fake delivery.
TOKENHUB_SMTP_HOST=
TOKENHUB_SMTP_PORT=587
TOKENHUB_SMTP_USERNAME=
TOKENHUB_SMTP_PASSWORD=
TOKENHUB_SMTP_FROM=
TOKENHUB_SMTP_SECURITY=starttls

# Private S3-compatible bucket. Compose supplies MinIO; native processes use this URL.
# Production: restricted application IAM credentials, no public bucket policy.
TOKENHUB_S3_ENDPOINT=http://127.0.0.1:9000
TOKENHUB_S3_BUCKET=tokenhub-v2
TOKENHUB_S3_REGION=us-east-1
TOKENHUB_S3_ACCESS_KEY=minioadmin
TOKENHUB_S3_SECRET_KEY=minioadmin
TOKENHUB_S3_FORCE_PATH_STYLE=true

# OEM custom-domain integration. Leave empty until the real account is ready.
TOKENHUB_CLOUDFLARE_API_TOKEN=
TOKENHUB_CLOUDFLARE_ZONE_ID=
TOKENHUB_CLOUDFLARE_CNAME_TARGET=
TOKENHUB_CLOUDFLARE_BASE_URL=

# Provider credentials, model capabilities/routes/prices and merchant configurations
# are entered by authorized staff in the product. No demo keys or fixed auth tokens.
# Mock endpoints are explicit integration-test configuration and never live defaults.
TOKENHUB_INTEGRATION_TEST_LOOPBACK=false
TOKENHUB_OTEL_EXPORTER_OTLP_ENDPOINT=
TOKENHUB_OTEL_SERVICE_NAME=tokenhub-api
TOKENHUB_LOG_LEVEL=info
# Required for private Prometheus scraping across containers; never expose /metrics.
TOKENHUB_METRICS_TOKEN=
TOKENHUB_GRAFANA_PASSWORD=
# Optional backup Compose profile. Separate random key, at least 32 characters.
# Preserve this AND the application encryption key outside the backed-up machine.
TOKENHUB_BACKUP_KEY=
TOKENHUB_BACKUP_INTERVAL_SECONDS=86400
