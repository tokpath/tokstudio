{
  "name": "TokenHub",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "install": "bash scripts/cloud-install.sh",
  "start": "bash scripts/cloud-start.sh",
  "terminals": [
    {
      "name": "api",
      "command": "cd backend && go run ./cmd/api"
    },
    {
      "name": "worker",
      "command": "cd backend && go run ./cmd/worker"
    },
    {
      "name": "web",
      "command": "cd web && npm run dev"
    }
  ],
  "ports": [
    { "name": "web", "port": 3000 },
    { "name": "api", "port": 8080 }
  ]
}
